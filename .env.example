# Postgres connection. With `docker compose up -d` using the provided docker-compose.yml:
DATABASE_URL="postgresql://recipe_ledger:recipe_ledger@localhost:55432/recipe_ledger"

# Google Gemini API key (server-only, never expose as NEXT_PUBLIC_). Get one at
# https://aistudio.google.com/apikey. Required for /scan (recipe photo parsing) and
# Coles search HTML parsing. Without it those code paths return a clear error.
GEMINI_API_KEY=""

# Auth.js session secret, required even for email+password sign-in (used to
# sign the session JWT). Generate with: npx auth secret (or `openssl rand -base64 32`)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth client (Auth.js Google provider), for signing in
# with Google in addition to email+password. Create at
# https://console.cloud.google.com/apis/credentials with redirect URI
# http://localhost:3000/api/auth/callback/google. Leave blank to only offer
# email+password sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend API key (server-only), used to send "forgot password" reset emails.
# Get one at https://resend.com/api-keys. Without it, reset emails are logged
# to the console instead of sent (fine for local dev). EMAIL_FROM defaults to
# Resend's sandbox sender, which can only deliver to your own account email
# until a sending domain is verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Recipes Book <onboarding@resend.dev>"
